diff -ru a/src/output-config.cpp b/src/output-config.cpp
--- a/src/output-config.cpp
+++ b/src/output-config.cpp
@@ -95,6 +95,24 @@
              .toLower() != QStringLiteral("translucent");
 }
 
+static bool parseSwitch(const QString &value, bool fallback) {
+  const QString v = value.trimmed().toLower();
+  if (v == QStringLiteral("1") || v == QStringLiteral("true") ||
+      v == QStringLiteral("yes") || v == QStringLiteral("on"))
+    return true;
+  if (v == QStringLiteral("0") || v == QStringLiteral("false") ||
+      v == QStringLiteral("no") || v == QStringLiteral("off"))
+    return false;
+  return fallback;
+}
+
+bool loadAutoSave(const QString &filePath) {
+  QSettings settings(filePath, QSettings::IniFormat);
+  const bool configured = parseSwitch(
+      settings.value(QStringLiteral("output/autosave")).toString(), false);
+  return parseSwitch(qEnvironmentVariable("OMASNAP_AUTOSAVE"), configured);
+}
+
 QString defaultConfigPath() {
   return QStandardPaths::writableLocation(QStandardPaths::ConfigLocation) +
          QStringLiteral("/omasnap/omasnap.conf");
